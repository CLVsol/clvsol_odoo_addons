<odoo>

    <record id="res_partner_contact_information_pattern_search_view_form" model="ir.ui.view">
        <field name="name">res.partner.contact_information_pattern.search.form</field>
        <field name="model">res.partner.contact_information_pattern.search</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_right">
                </div>
                <label for="res_partner_ids"/>
                <field name="res_partner_ids"/>
                <!--group>
                    <group>
                        <field name="employee_id" options='{"no_open": True, "no_create": True}'/>
                        <field name="date_received"/>
                    </group>
                </group-->
                <footer>
                    <button 
                        type="object"
                        name="do_res_partner_contact_information_pattern_search"
                        string="Partner Contact Informaation Pattern Search"
                        class="oe_highlight"
                        />
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <!-- More button Action -->
    <record id="res_partner_contact_information_pattern_search_action" model="ir.actions.act_window">
        <field name="name">Partner Contact Informaation Pattern Search</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="res_model">res.partner.contact_information_pattern.search</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
